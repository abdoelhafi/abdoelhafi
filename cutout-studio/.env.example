# Copy to .env and fill in what you have. Everything is optional: with no keys the app runs on offline fixtures.

# Which LLM writes ideas, scripts and timelines: auto | gemini | claude | mock
# auto = Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else mock.
LLM_PROVIDER=auto

# Gemini: used for ideas/scripts/timelines (when chosen) AND for generating images inside the app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro-latest
# Free-tier keys have no Pro quota: the app retries on this model automatically.
GEMINI_FALLBACK_MODEL=gemini-flash-latest
# Model used for web-search fact-checking (works on the free tier).
GEMINI_SEARCH_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Claude (Anthropic API)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ElevenLabs (free tier: about 10,000 characters a month; the app caches audio and asks before spending)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Render on GitHub Actions (optional): see README "Render on GitHub Actions"
GITHUB_TOKEN=
RENDER_SHARED_SECRET=
# PUBLIC_URL=https://your-app.example.com   (Render sets RENDER_EXTERNAL_URL automatically)
# GITHUB_REPO=abdoelhafi/abdoelhafi
# GITHUB_APP_REF=ccr-18ed63bb-3wocck

# Small hosts (512 MB): lighter Chromium; renders may still not fit, use GitHub Actions
# LOW_MEMORY=1
# Protect a deployed copy (user admin)
# APP_PASSWORD=

PORT=3000
# PYTHON=python3
# FFMPEG=ffmpeg
